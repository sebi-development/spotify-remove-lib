{
  "name": "spotify-library-cleaner",
  "version": "1.0.0",
  "description": "Safely inspect, preview, and wipe items from your Spotify library with real-time WebSocket progress.",
  "scripts": {
    "start": "NODE_ENV=production tsx server/server.ts",
    "dev": "tsx watch server/server.ts",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "spotify",
    "library-cleaner",
    "react",
    "express",
    "typescript",
    "websockets",
    "vite",
    "tailwind"
  ],
  "author": "Sebik",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}